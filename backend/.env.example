# Copy to .env and adjust as needed. All of these have working defaults —
# the app runs with none of this set.

# SQLite by default (backend/freshguard.db). Swap for a Postgres URL
# (postgresql://user:pass@host:5432/dbname) when moving beyond a local demo —
# the schema is Postgres-compatible via SQLAlchemy, no code changes needed.
DATABASE_URL=

# Only "simulation" is implemented (see backend/app/vision/). Reliable,
# offline, and what the seeded demo data + FG-10241 walkthrough assume.
VISION_MODE=simulation

# Not read by the simulation provider. Reserved for a future real vision
# provider (VisionProvider implementation) to pick up credentials from —
# never hard-code an API key in code.
VISION_API_KEY=

# Overrides the Phase 1 risk model's reported version string.
MODEL_VERSION=v0.1-prototype

# true (default): seeded data, simulation vision, predictable demo
# scenarios. Set to false only once real order/product data replaces the
# seed script — the app doesn't currently branch behavior on this beyond
# labeling (GET /api/health exposes it for the frontend to display).
DEMO_MODE=true
